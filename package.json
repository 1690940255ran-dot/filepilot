{
  "name": "filepilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "本地文件整理智能体（工作名：文件领航）—— 用自然语言整理本地文件，所有变更可预览、可确认、可追踪、可撤销",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "desktop:build": "python scripts/build-desktop.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:prod-csp": "playwright test --config playwright.prod-csp.config.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "bundle:workers": "python scripts/bundle-workers.py",
    "validators:generate": "node scripts/generate-validators.mjs",
    "validators:check": "node scripts/generate-validators.mjs --check",
    "contracts:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-contracts.ps1 && pnpm validators:generate",
    "contracts:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-contracts.ps1 && pnpm validators:check",
    "setup:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-toolchain.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
